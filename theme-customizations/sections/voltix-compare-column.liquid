{%- comment -%}
  One product column for the VOLTIX compare table. Fetched with the Section Rendering API
  (/products/<handle>?section_id=voltix-compare-column); voltix-commerce.js lines the rows up.
{%- endcomment -%}
{%- if product != blank -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
  <article data-vx-compare-item data-handle="{{ product.handle }}">
    <div data-head class="vx-compare__head">
      <a href="{{ product.url }}" class="vx-compare__media">{% render 'voltix-product-thumb', product: product, width: 240 %}</a>
      <a href="{{ product.url }}" class="vx-compare__name">{{ product.title | escape }}</a>
      <p class="vx-compare__price">
        {{ variant.price | money }}
        {%- if variant.compare_at_price > variant.price -%} <s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
      </p>
      {% render 'voltix-quick-add-button', product: product %}
      <button type="button" class="vx-link vx-compare__remove" onclick="window.VoltixCompare.remove('{{ product.handle }}'); this.closest('td, th').style.opacity = .35">{{ 'voltix.remove' | t }}</button>
    </div>
    {% render 'voltix-specs-table', product: product, limit: 20 %}
  </article>
{%- endif -%}

{% schema %}
{ "name": "VOLTIX compare column", "tag": "div" }
{% endschema %}
