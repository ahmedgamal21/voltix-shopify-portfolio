{%- comment -%}
  VOLTIX newsletter sign-up. Uses Shopify's customer form (tag: newsletter).
{%- endcomment -%}
<section class="vx-section vx-news vx-wrap">
  <div class="vx-news__box">
    <div class="vx-news__copy">
      <h2 class="vx-news__title">{% render 'voltix-text', value: section.settings.heading, key: 'voltix.news_heading' %}</h2>
      <p class="vx-news__text">{% render 'voltix-text', value: section.settings.text, key: 'voltix.news_text' %}</p>
    </div>
    {%- form 'customer', id: 'VxNewsletter', class: 'vx-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="vx-news__msg" role="status">{% render 'voltix-text', value: section.settings.success, key: 'voltix.news_success' %}</p>
      {%- else -%}
        <label for="VxNewsEmail-{{ section.id }}" class="visually-hidden">{{ 'voltix.email_label' | t }}</label>
        <input
          id="VxNewsEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          autocomplete="email"
          required
          placeholder="{{ 'voltix.email_placeholder' | t }}"
          {% if form.errors %}aria-invalid="true" aria-describedby="VxNewsError-{{ section.id }}"{% endif %}
        >
        <button type="submit" class="vx-btn vx-btn--lg">{% render 'voltix-text', value: section.settings.button_label, key: 'voltix.news_button' %}</button>
        {%- if form.errors -%}
          <p id="VxNewsError-{{ section.id }}" class="vx-news__msg vx-news__msg--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "VOLTIX newsletter",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get new arrivals first" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the VOLTIX list for launches and offers. No spam — unsubscribe anytime." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks for subscribing!" }
  ],
  "presets": [{ "name": "VOLTIX newsletter" }]
}
{% endschema %}
