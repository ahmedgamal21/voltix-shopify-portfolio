{%- comment -%}
  VOLTIX announcement bar (navy). Empty messages use translated copy (voltix.announcement_1..3).
{%- endcomment -%}
<div class="vx-announce" role="region" aria-label="{{ 'voltix.services_label' | t }}">
  <ul class="vx-announce__list vx-wrap" role="list">
    {%- for i in (1..3) -%}
      {%- liquid
        assign setting_id = 'message_' | append: i
        assign key = 'voltix.announcement_' | append: i
        assign icon = 'delivery'
        if i == 2
          assign icon = 'shield'
        elsif i == 3
          assign icon = 'badge'
        endif
      -%}
      <li class="vx-announce__item">
        {% render 'voltix-icon', icon: icon, size: 16 %}
        <span>{% render 'voltix-text', value: section.settings[setting_id], key: key %}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "VOLTIX announcements",
  "tag": "div",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "paragraph", "content": "Leave empty to use the English and Arabic copy from the theme language files." },
    { "type": "text", "id": "message_1", "label": "Message 1" },
    { "type": "text", "id": "message_2", "label": "Message 2" },
    { "type": "text", "id": "message_3", "label": "Message 3" }
  ],
  "presets": [{ "name": "VOLTIX announcements" }]
}
{% endschema %}

