{%- comment -%}
  VOLTIX line icons (24x24, stroke uses currentColor).

  Accepts:
  - icon {String}: icon name (see the case list below)
  - size {Number}: optional pixel size, default 24

  Usage:
  {% render 'voltix-icon', icon: 'tv', size: 32 %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 24
-%}
<svg
  class="vx-icon"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'air-conditioning' -%}
      <rect x="3" y="5" width="18" height="8" rx="2"/><path d="M7 17v2M12 17v3M17 17v2"/>
    {%- when 'tv' -%}
      <rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>
    {%- when 'mobile' -%}
      <rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>
    {%- when 'computer' -%}
      <rect x="4" y="5" width="16" height="10" rx="1"/><path d="M2 19h20"/>
    {%- when 'gaming' -%}
      <rect x="2" y="7" width="20" height="10" rx="5"/><path d="M7 10v4M5 12h4"/><circle cx="16" cy="11" r=".8"/><circle cx="18" cy="13" r=".8"/>
    {%- when 'large-appliance' -%}
      <rect x="6" y="2" width="12" height="20" rx="2"/><path d="M6 10h12M9 5v2M9 13v3"/>
    {%- when 'kitchen' -%}
      <path d="M8 3h8l-1 7H9z"/><path d="M7 10h10v9a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2z"/>
    {%- when 'cleaning' -%}
      <path d="M14 3v11"/><path d="M8 21h11a2 2 0 0 0 0-4h-7a4 4 0 0 0-4 4z"/>
    {%- when 'camera' -%}
      <path d="M3 8h4l2-3h6l2 3h4v11H3z"/><circle cx="12" cy="13" r="3.5"/>
    {%- when 'smart-home' -%}
      <path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M9.5 15.5a3.5 3.5 0 0 1 5 0"/>
    {%- when 'beauty' -%}
      <circle cx="9" cy="9" r="5"/><path d="M14 9h7M9 14l1 7"/>
    {%- when 'audio' -%}
      <path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1"/><rect x="17" y="14" width="4" height="6" rx="1"/>
    {%- when 'fitness' -%}
      <path d="M3 12h4l3-7 4 14 3-7h4"/>
    {%- when 'toys' -%}
      <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>
    {%- when 'travel' -%}
      <rect x="4" y="7" width="16" height="13" rx="2"/><path d="M9 7V4h6v3M9 11v5M15 11v5"/>
    {%- when 'office' -%}
      <rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V4h8v3M3 13h18"/>
    {%- when 'delivery' -%}
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
    {%- when 'shield' -%}
      <path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'badge' -%}
      <path d="M4 7h16v12H4z"/><path d="M8 7V5h8v2M4 12h16"/>
    {%- when 'support' -%}
      <path d="M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2v-6h4M4 12v4a2 2 0 0 0 2 2h2v-6H4"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
    {%- when 'menu' -%}
      <path d="M4 6h16M4 12h16M4 18h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>
    {%- when 'card' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/>
    {%- when 'returns' -%}
      <path d="M4 10h11a5 5 0 0 1 0 10h-3"/><path d="m8 6-4 4 4 4"/>
    {%- when 'compare' -%}
      <path d="M7 4v16M17 4v16"/><path d="m4 8 3-3 3 3M14 16l3 3 3-3"/>
    {%- when 'eye' -%}
      <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'check' -%}
      <path d="m5 12 5 5 9-10"/>
    {%- when 'truck-fast' -%}
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7M1 10h4M1 13h3"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
    {%- when 'image' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m21 16-5-5-9 8"/>
    {%- else -%}
      <rect x="4" y="4" width="16" height="16" rx="3"/>
  {%- endcase -%}
</svg>
